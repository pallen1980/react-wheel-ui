# Mock API Service Environment Variables

# Firebase Configuration
FIREBASE_PROJECT_ID=myauth-1569840907611

# CORS Configuration - Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:51235,http://localhost:3000,http://localhost:51235

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# Logging Configuration
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

# Optional: Custom port (default is 3001)
# ASPNETCORE_HTTP_PORTS=3001

# Optional: Custom URLs
# ASPNETCORE_URLS=http://+:3001