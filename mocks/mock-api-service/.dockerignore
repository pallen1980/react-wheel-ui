# .dockerignore for Mock API Service

# Build outputs
bin/
obj/
out/
publish/

# IDE and editor files
.vs/
.vscode/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
logs/

# Runtime files
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Git files
.git/
.gitignore
.gitattributes

# Documentation
README.md
docs/

# Test files
Tests/
*.Test.cs
*Tests.cs

# Docker files (avoid recursive copying)
Dockerfile*
.dockerignore

# Environment files
.env
.env.local
.env.development
.env.test
.env.production