# Docker Production Environment Configuration
# This file contains environment variables for Docker containerized deployment

# API Configuration - uses localhost for browser access (React app runs in browser, not container)
VITE_API_BASE_URL=http://localhost:3001

# Main Application URL - external access
VITE_MAIN_APP_URL=http://localhost:5173

# Application Title
VITE_APP_TITLE=User Management

# Docker-specific settings
NODE_ENV=production