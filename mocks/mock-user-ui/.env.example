# API Configuration
# For local development
VITE_API_BASE_URL=http://localhost:3001
# For Docker development (use service name)
# VITE_API_BASE_URL=http://mock-api:3001

# Main Application URL for redirects
# For local development
VITE_MAIN_APP_URL=http://localhost:5173
# For Docker development
# VITE_MAIN_APP_URL=http://localhost:5173

# Application Title
VITE_APP_TITLE=User Management

# Docker-specific environment variables
# These are used when building and running in Docker containers
# DOCKER_API_BASE_URL=http://mock-api:3001
# DOCKER_MAIN_APP_URL=http://localhost:5173